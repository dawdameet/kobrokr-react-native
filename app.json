{
  "expo": {
    "name": "Kobrokr",
    "slug": "kobrokr-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kobrokr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.kobrokr.mobile",
      "buildNumber": "4",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDisplayName": "Kobrokr",
        "NSCameraUsageDescription": "Allow Kobrokr to access your camera so you can take photos for property listings.",
        "NSPhotoLibraryUsageDescription": "Allow Kobrokr to access your photos so you can upload property listings and profile images.",
        "NSMicrophoneUsageDescription": "Allow Kobrokr to access your microphone when recording property walkthrough videos.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:kobrokr.com",
        "applinks:www.kobrokr.com"
      ],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2C54F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "package": "com.kobrokr.mobile",
      "versionCode": 4,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kobrokr.com",
              "pathPrefix": "/client-share"
            },
            {
              "scheme": "https",
              "host": "www.kobrokr.com",
              "pathPrefix": "/client-share"
            },
            {
              "scheme": "https",
              "host": "kobrokr.com",
              "pathPrefix": "/signup"
            },
            {
              "scheme": "https",
              "host": "www.kobrokr.com",
              "pathPrefix": "/signup"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2C54F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IBMPlexSans-Regular.ttf",
            "./assets/fonts/IBMPlexSans-Medium.ttf",
            "./assets/fonts/IBMPlexSans-SemiBold.ttf",
            "./assets/fonts/IBMPlexSans-Bold.ttf",
            "./assets/fonts/SpaceGrotesk-Medium.ttf",
            "./assets/fonts/SpaceGrotesk-SemiBold.ttf",
            "./assets/fonts/SpaceGrotesk-Bold.ttf",
            "./assets/fonts/IBMPlexMono-Regular.ttf",
            "./assets/fonts/IBMPlexMono-Medium.ttf",
            "./assets/fonts/IBMPlexMono-SemiBold.ttf"
          ]
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Kobrokr to access your photos so you can upload property listings and profile images.",
          "cameraPermission": "Allow Kobrokr to access your camera so you can take photos for property listings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a521df33-404d-433e-ab98-bab80ec7563e"
      }
    }
  }
}
